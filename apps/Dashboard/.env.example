# Public Sanity identifiers (same names as the website). Not write secrets.
# Dashboard does not load apps/web/.env.local — set these here for local reads.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# HMAC session signing. Must be at least 32 characters. Server-only.
AUTH_SECRET=

# Environment Owner (plaintext compared server-side only; not stored in Sanity)
DASHBOARD_OWNER_EMAIL=
DASHBOARD_OWNER_PASSWORD=

# Sanity write token. Server-only. Never expose to the browser.
SANITY_API_WRITE_TOKEN=

# Optional: POST website revalidation after mutations
SANITY_REVALIDATE_SECRET=
WEBSITE_REVALIDATE_URL=

# PostgreSQL (Phase 1 foundation; not wired to the Dashboard yet)
DATABASE_URL=

# Optional OpenAI-compatible translation (server-only). Drafts require human review.
TRANSLATION_API_KEY=
TRANSLATION_API_URL=
TRANSLATION_MODEL=
