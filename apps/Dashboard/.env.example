# HMAC session signing. Must be at least 32 characters. Server-only.
AUTH_SECRET=

# Environment Owner (plaintext compared server-side only; migrate to Prisma User later)
DASHBOARD_OWNER_EMAIL=
DASHBOARD_OWNER_PASSWORD=

# PostgreSQL. Server-only. Never expose to the browser.
DATABASE_URL=

# Optional: POST website revalidation after CMS saves
REVALIDATE_SECRET=
WEBSITE_REVALIDATE_URL=http://localhost:3001/api/revalidate

# Optional OpenAI-compatible translation (server-only). Drafts require human review.
TRANSLATION_API_KEY=
TRANSLATION_API_URL=
TRANSLATION_MODEL=
