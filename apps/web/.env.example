# PostgreSQL (required). Copy to gitignored .env.local — never commit real credentials.
DATABASE_URL=

# Public site URL (SEO / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Shared with the Dashboard. POST /api/revalidate header x-revalidate-secret.
# Empty = endpoint always returns 401 (fail closed).
REVALIDATE_SECRET=
