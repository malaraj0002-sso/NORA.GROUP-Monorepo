# PostgreSQL connection for Prisma (monorepo root).
# Set a local connection string in gitignored .env — never commit real credentials.
DATABASE_URL=

# Optional: Dashboard owner bootstrap and website revalidate (also set in each app .env.local)
AUTH_SECRET=
DASHBOARD_OWNER_EMAIL=
DASHBOARD_OWNER_PASSWORD=
REVALIDATE_SECRET=
WEBSITE_REVALIDATE_URL=http://localhost:3001/api/revalidate
NEXT_PUBLIC_SITE_URL=http://localhost:3001
