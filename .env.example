# PostgreSQL connection for Prisma (monorepo root).
# Copy to gitignored .env, set DATABASE_URL, then run: pnpm bootstrap
# On Linux, bash scripts/fix-linux-dev.sh can write this line after Postgres is running.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nora_group

# Optional — only for docker compose (scripts/fix-linux-dev.sh fills this; never commit the real value).
POSTGRES_PASSWORD=

# Optional — pnpm bootstrap fills these if empty (local only).
REVALIDATE_SECRET=
WEBSITE_REVALIDATE_URL=http://localhost:3001/api/revalidate
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# One-time Owner bootstrap only (never stored as the login mechanism).
# OWNER_BOOTSTRAP_EMAIL=owner@localhost
# OWNER_BOOTSTRAP_PASSWORD=
# Then run: pnpm bootstrap:owner
