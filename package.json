{
  "name": "nora-group-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @nora/web dev",
    "dev:dashboard": "pnpm --filter @nora/dashboard dev",
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:dashboard\"",
    "build:web": "pnpm --filter @nora/web build",
    "build:dashboard": "pnpm --filter @nora/dashboard build",
    "build": "pnpm build:web && pnpm build:dashboard",
    "lint:web": "pnpm --filter @nora/web lint",
    "lint:dashboard": "pnpm --filter @nora/dashboard lint",
    "lint": "pnpm lint:web && pnpm lint:dashboard",
    "typecheck:web": "pnpm --filter @nora/web typecheck",
    "typecheck:dashboard": "pnpm --filter @nora/dashboard typecheck",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:dashboard",
    "check": "pnpm typecheck:web && pnpm build",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate && node prisma/copy-dashboard-client.mjs",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:ensure-local": "tsx prisma/ensure-local-database.ts",
    "prisma:seed": "prisma db seed",
    "setup:local": "pnpm prisma generate && pnpm prisma:ensure-local && pnpm prisma migrate deploy && pnpm prisma:seed",
    "bootstrap": "tsx scripts/bootstrap-local.ts",
    "postgres:contract": "pnpm --filter @nora/web postgres:contract",
    "postgres:parity": "pnpm --filter @nora/web postgres:parity",
    "postgres:dashboard-check": "pnpm --filter @nora/dashboard postgres:check"
  },
  "prisma": {
    "seed": "pnpm --filter @nora/web postgres:seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "6.16.3",
    "tsx": "^4.20.5"
  },
  "dependencies": {
    "@prisma/client": "6.16.3"
  }
}
