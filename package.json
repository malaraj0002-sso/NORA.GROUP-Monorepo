{
	"name": "nora-group-monorepo",
	"version": "1.0.0",
	"private": true,
	"scripts": {
	  "dev:web": "pnpm --filter web dev",
	  "dev:dashboard": "pnpm --filter dashboard dev",
	  "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:dashboard\"",
	  "build:web": "pnpm --filter web build",
	  "build:dashboard": "pnpm --filter dashboard build",
	  "build": "pnpm build:web && pnpm build:dashboard"
	},
	"devDependencies": {
	  "concurrently": "^9.2.1"
	}
  }